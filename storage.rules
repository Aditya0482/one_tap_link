rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 1. Template preview images: readable by everyone on all devices
    match /templates/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 2. Default rule for all files: readable by all, writable by authenticated admin
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
