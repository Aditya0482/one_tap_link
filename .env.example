# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SHEETS_WEBHOOK_URL: Optional Google Apps Script Web App URL for contact inquiries
# Submissions from the contact form are automatically forwarded to your Google Sheet.
GOOGLE_SHEETS_WEBHOOK_URL=

# RAZORPAY_KEY_ID: Your Razorpay API Key ID (Public — safe for frontend)
# Get from: Razorpay Dashboard (https://dashboard.razorpay.com/app/keys) > Generate Test/Live Key
# Test keys start with 'rzp_test_', Live keys start with 'rzp_live_'
RAZORPAY_KEY_ID=

# RAZORPAY_KEY_SECRET: Your Razorpay API Key Secret (PRIVATE — backend server only)
# NEVER expose this in frontend code or public repositories
RAZORPAY_KEY_SECRET=

# RAZORPAY_TEST_MODE: Set to 'true' when using test keys, 'false' for live/production keys
RAZORPAY_TEST_MODE=true

# RAZORPAY_WEBHOOK_SECRET: Optional — for verifying Razorpay webhook event signatures
# Configure from Razorpay Dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET=

# DATABASE_URL: PostgreSQL Connection URL (e.g. postgresql://user:password@localhost:5432/onetaplink)
# If omitted, system seamlessly runs with local JSON storage fallback.
DATABASE_URL=

# ADMIN_PASSWORD: Admin portal permanent password (Default: admin123)
ADMIN_PASSWORD=

# Optional Client-side Firebase overrides (if not using firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
