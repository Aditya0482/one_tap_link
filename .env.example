# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SHEETS_WEBHOOK_URL: Optional Google Apps Script Web App URL for contact inquiries
# Submissions from the contact form are automatically forwarded to your Google Sheet.
GOOGLE_SHEETS_WEBHOOK_URL=

# INSTAMOJO_API_KEY: Your Instamojo API Key
# Obtained from Instamojo Dashboard > API & Plugins (https://test.instamojo.com/integrations or https://www.instamojo.com/integrations)
INSTAMOJO_API_KEY=

# INSTAMOJO_AUTH_TOKEN: Your Instamojo Auth Token (Kept strictly on backend server)
INSTAMOJO_AUTH_TOKEN=

# INSTAMOJO_SALT: Your Instamojo Private Salt (Used for Webhook MAC SHA1 signature verification)
INSTAMOJO_SALT=

# INSTAMOJO_SANDBOX: Set to 'true' for test sandbox (test.instamojo.com) or 'false' for production (instamojo.com)
INSTAMOJO_SANDBOX=true

# DATABASE_URL: PostgreSQL Connection URL (e.g. postgresql://user:password@localhost:5432/onetaplink)
# If omitted, system seamlessly runs with local JSON storage fallback.
DATABASE_URL=

# ADMIN_PASSWORD: Admin portal permanent password (Default: admin123)
ADMIN_PASSWORD=

# Optional Client-side Firebase overrides (if not using firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
