{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Firestore Database Blueprint",
  "entities": {
    "users": {
      "title": "User Accounts",
      "description": "User profiles and admin accounts",
      "fields": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "purchases": {
      "title": "Customer Purchases",
      "description": "Customer template purchases verified through Razorpay",
      "fields": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "amount": { "type": "number" },
        "razorpayOrderId": { "type": "string" },
        "razorpayPaymentId": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "purchasedAt": { "type": "string" },
        "accessUrl": { "type": "string" }
      }
    }
  }
}
